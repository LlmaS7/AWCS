+                and self.tick < self.plan_valid_until and can_retain_routes(self)):
+            self.dirty = False
+            self.metrics['retained_rechecks'] = self.metrics.get('retained_rechecks', 0)+1
+            return True
+        self.plan_valid_until = None
+        return False
